# Copy to .env for local development. .env is excluded from Git.
PORT=3000

# Optional Google Maps browser integration. Both values are required for the map.
# VITE_ values are public in the browser bundle, not private secrets.
# Restrict this key to approved HTTP referrers and the Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Optional private SERVER key for Open-Meteo customer historical weather access.
# Commercial deployments need the appropriate provider plan.
# With no key, the public archive endpoint is used for supported prototype use.
# Never prefix this secret with VITE_.
OPEN_METEO_API_KEY=

# Optional Firebase browser configuration; blank values leave cloud features off.
# Set API key, auth domain, project ID, and app ID together to enable initialization.
# Configure Auth providers/authorized domains and deploy firestore.rules separately.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Blank uses the (default) Firestore database.
VITE_FIREBASE_DATABASE_ID=
